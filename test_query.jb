import web

let app = web()

let users = app.db.collection("users")

users.insert({
    "name": "Alex",
    "age": 15
})

users.insert({
    "name": "Sam",
    "age": 18
})

users.insert({
    "name": "John",
    "age": 12
})

say(users.sort("age"))

say(users.sort("age", true))

say(users.limit(2))

say(users.count())

app.run(8080)