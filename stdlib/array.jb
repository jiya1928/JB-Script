fn first(items) {
    if len(items) == 0 {
        return null
    }

    return items[0]
}

fn last(items) {
    if len(items) == 0 {
        return null
    }

    return items[len(items) - 1]
}

fn length(items) {
    return len(items)
}

fn contains(items, value) {
    for item in items {
        if item == value {
            return true
        }
    }

    return false
}

fn reverse(items) {
    let result = []

    for item in items {
        result.unshift(item)
    }

    return result
}